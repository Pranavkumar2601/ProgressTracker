{
  "buildCommand": "npm run build",
  "framework": "static",
  "outputDirectory": ".",
  "env": {
    "GOOGLE_CLIENT_ID": "@google_client_id"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
